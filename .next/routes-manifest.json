{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/finance",
      "regex": "^/finance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance(?:/)?$"
    },
    {
      "page": "/finance/About",
      "regex": "^/finance/About(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/About(?:/)?$"
    },
    {
      "page": "/finance/auth",
      "regex": "^/finance/auth(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/auth(?:/)?$"
    },
    {
      "page": "/finance/Contact",
      "regex": "^/finance/Contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/Contact(?:/)?$"
    },
    {
      "page": "/finance/Services",
      "regex": "^/finance/Services(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finance/Services(?:/)?$"
    },
    {
      "page": "/landing/medicare360guide",
      "regex": "^/landing/medicare360guide(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/landing/medicare360guide(?:/)?$"
    },
    {
      "page": "/whatsapp",
      "regex": "^/whatsapp(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/whatsapp(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}